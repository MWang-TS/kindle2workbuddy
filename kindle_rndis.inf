[Version]
Signature           = "$Windows NT$"
Class               = Net
ClassGuid           = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider            = %Provider%
DriverVer           = 08/05/2026,1.0.0.1
PnpLockdown         = 1

[Manufacturer]
%Manufacturer%      = RNDIS, NTamd64.10

[RNDIS.NTamd64.10]
%DeviceName%        = RNDIS.Install, USB\VID_0525&PID_A4A2

[RNDIS.Install]
Characteristics     = 0x84
BusType             = 15
AddReg              = RNDIS.AddReg
Include             = netrndis.inf
Needs               = RNDIS.NT.Reg
CopyFiles           = RNDIS.CopyFiles

[RNDIS.AddReg]
HKR, Ndi,           Service,           0, "RNDISMP"
HKR, Ndi\Interfaces, UpperRange,       0, "ndis5"
HKR, Ndi\Interfaces, LowerRange,       0, "ethernet"

[RNDIS.CopyFiles]

[RNDIS.Install.Services]
AddService          = RNDISMP, 0x00000002, RNDIS.ServiceInst

[RNDIS.ServiceInst]
DisplayName         = %ServiceName%
ServiceType         = 1
StartType           = 3
ErrorControl        = 1
ServiceBinary       = %12%\rndismp.sys

[Strings]
Provider            = "WorkBuddy"
Manufacturer        = "Linux-USB Gadget"
DeviceName          = "Kindle RNDIS Ethernet Gadget"
ServiceName         = "Microsoft RNDIS Miniport"
